# ── Core ───────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Database ───────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/keystone_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your_256_bit_base64_secret

# ── AI Triage (Feature 1) ──────────────────────────────────────────────────────
# OpenAI: https://platform.openai.com/api-keys
# Gemini: use base_url=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=sk-...
AI_MODEL_NAME=gpt-4o-mini

# ── Email / SMTP (Feature 4) ───────────────────────────────────────────────────
# SendGrid: MAIL_USERNAME=apikey, MAIL_PASSWORD=SG.your-key
# Amazon SES: MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=SG.your_sendgrid_api_key
MAIL_FROM=noreply@yourdomain.com

# ── Twilio SMS (Feature 4) ─────────────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── Frontend URL (used in email links) ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
